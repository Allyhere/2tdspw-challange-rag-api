PORT=3000
# Local Compose: bolt://localhost:7687
# Aura / Render: paste Connect URI, then resume the instance if DNS fails (ENOTFOUND).
# neo4j+s://….databases.neo4j.io is rewritten to bolt+s:// (no cluster routing).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Aura downloads NEO4J_USERNAME — the API accepts either name
NEO4J_PASSWORD=password
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
NLP_MODEL=gemini-3.5-flash-lite
EMBED_DIMENSIONS=768
VECTOR_K=8
