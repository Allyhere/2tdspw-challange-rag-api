PORT=3000
# Local Compose: bolt://localhost:7687
# Aura / Render: paste Connect URI, then resume the instance if DNS fails (ENOTFOUND).
# Keep the Aura Connect URI as neo4j+s://. bolt+s authenticates and then misses the database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Aura downloads NEO4J_USERNAME — the API accepts either name
NEO4J_PASSWORD=password
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
NLP_MODEL=gemini-3.5-flash-lite
EMBED_DIMENSIONS=768
VECTOR_K=8
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM em uma linha com \n; nunca commite a chave real.
FIREBASE_PRIVATE_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,https://2tdspw-challange-front-user.vercel.app
JSON_BODY_LIMIT=32kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
GEMINI_TIMEOUT_MS=20000
# Webhook da clínica (Nest). Vazio desliga o aviso; a conversa continua.
NEST_CHAT_WEBHOOK_URL=
NEST_CHAT_WEBHOOK_SECRET=
